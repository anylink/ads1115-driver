# ADS1115 四路分时复用示例的默认配置

# tick 提到 1000 Hz：让阻塞式读取里的 vTaskDelay(1) 真的是 1 ms，
# 否则 100 Hz 下 1 ms 会被拉长到一个 10 ms tick。
CONFIG_FREERTOS_HZ=1000

# 主任务栈：轮询 + 日志输出够用，需要更多可在 menuconfig 里调
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# 目标芯片不写死在这里，用 idf.py set-target <chip> 指定，
# 例如：idf.py set-target esp32s3 / esp32c3 / esp32 / esp32c6
